# PostgreSQL Database Connection URL
# Local Docker default: postgres://relay:relay_secret@localhost:5432/relay_db
# Cloud (e.g. Neon, Supabase): postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require
DATABASE_URL="postgres://relay:relay_secret@localhost:5432/relay_db"

# Redis Connection URL (for BullMQ queue)
# Local Docker default: redis://localhost:6379
# Cloud (e.g. Upstash, Redis Cloud): rediss://default:password@xyz.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# Session / Auth Secret (at least 32 characters for security)
AUTH_SECRET="development_secret_change_in_production_min_32_chars"

# Node Environment
NODE_ENV="development"
PORT="3000"
